# Device/Pi settings. Copy values to a local environment, never commit secrets.
# LINGOSTEP_VOSK_MODEL=/home/pi/lingo-step/models/speech/vosk-model-small-en-us-0.15
# LINGOSTEP_MIC_DEVICE=USB PnP Sound Device
# LETTERSTARS_DATA_DIR=/home/pi/lingo-step/data
# LETTERSTARS_CAMERA=0
# LINGOSTEP_CLOUD_URL=https://your-cloud-host.example
# LINGOSTEP_DEVICE_TOKEN=PLEASE_SET_A_LONG_RANDOM_SECRET
#
# Cloud server ONLY:
# LINGOSTEP_SESSION_SECRET=PLEASE_SET_A_LONG_RANDOM_SECRET_32_CHARS
# LINGOSTEP_DEVICE_TOKEN=SAME_TOKEN_AS_PI
# LINGOSTEP_CLOUD_DB=/var/lib/lingostep/portal.db
# LINGOSTEP_COOKIE_SECURE=1  # only set 0 for localhost development
